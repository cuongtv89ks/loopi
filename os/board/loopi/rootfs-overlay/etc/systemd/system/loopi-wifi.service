[Unit]
Description=WiFi for wlan0 (wpa_supplicant, config on /data)
After=loopi-provision.service sys-subsystem-net-devices-wlan0.device
BindsTo=sys-subsystem-net-devices-wlan0.device
RequiresMountsFor=/data
ConditionPathExists=/data/config/wpa_supplicant-wlan0.conf
Before=network.target
Wants=network.target

[Service]
ExecStart=/usr/sbin/wpa_supplicant -i wlan0 -c /data/config/wpa_supplicant-wlan0.conf
Restart=always
RestartSec=5

[Install]
# BindsTo= stops this when wlan0 disappears (a brcmfmac reset or module reload); being wanted by the wlan0 device starts
# it again when wlan0 is back (the stock wpa_supplicant-nl80211@.service pattern). multi-user.target covers the first start.
WantedBy=multi-user.target sys-subsystem-net-devices-wlan0.device

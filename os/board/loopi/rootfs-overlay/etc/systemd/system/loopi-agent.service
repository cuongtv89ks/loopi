[Unit]
Description=Loopi capture agent
After=loopi-provision.service loopi-growdata.service network-online.target
Wants=network-online.target
RequiresMountsFor=/data

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/libexec/loopi/run-agent
# The privacy LED (the ACT LED by default, spec D18) is a LED class device and keeps its level when the agent dies. This
# runs after every exit of the agent, also SIGKILL or a watchdog abort, once the whole control group (recorders
# included) is gone, and switches the configured LED off. It is the packaged binary also when run-agent starts a
# deployed dev build. "-": a failure here never fails the unit.
ExecStopPost=-/usr/bin/loopi-agent led-off
Restart=always
RestartSec=2
WatchdogSec=30
KillMode=control-group
TimeoutStopSec=15
Environment=RUST_LOG=info
Environment=LIBCAMERA_LOG_LEVELS=*:WARN

[Install]
WantedBy=multi-user.target

# Toolchain built by Buildroot (works on x86_64 and arm64 build hosts)
# BR2_TOOLCHAIN_EXTERNAL is not set
BR2_TOOLCHAIN_BUILDROOT=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_6_1=y
# Patches for upstream packages live in the external tree (os/patches/<package>/*.patch), e.g. libcamera-apps.
# raspberrypi0w_defconfig already sets BR2_GLOBAL_PATCH_DIR="board/raspberrypi/patches" (the kernel and kernel
# headers hash files); this line replaces it, so that directory has to stay in the list.
BR2_GLOBAL_PATCH_DIR="board/raspberrypi/patches $(BR2_EXTERNAL_LOOPI_PATH)/patches"
# System
BR2_TARGET_GENERIC_HOSTNAME="loopi"
BR2_TARGET_GENERIC_ISSUE="Loopi"
BR2_INIT_SYSTEMD=y
BR2_SYSTEM_DHCP=""
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_LOOPI_PATH)/board/loopi/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_LOOPI_PATH)/board/loopi/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS=""
# Kernel and firmware (versions come from raspberrypi0w_defconfig)
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_LOOPI_PATH)/board/loopi/linux.fragment"
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_LOOPI_PATH)/board/loopi/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y
# Filesystems: read-only squashfs root, host tools for the boot and data images
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_LZ4=y
# BR2_TARGET_ROOTFS_EXT2 is not set
BR2_PACKAGE_HOST_E2FSPROGS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
# Read-only root support and first-boot data partition grow
# The upstream defconfig remounts / read-write; BR2_INIT_SYSTEMD_VAR_FACTORY depends on that being off.
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_INIT_SYSTEMD_VAR_FACTORY=y
BR2_PACKAGE_UTIL_LINUX=y
# sfdisk (used by grow-data.sh) comes with the "basic set"; there is no separate fdisks option
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
# Boot FAT repair at startup: fstab pass 2 for /boot makes systemd-fsck@dev-mmcblk0p1.service run `fsck -a`, which needs
# fsck.vfat (a link to fsck.fat). Needed in prod too: the device loses power often and /boot holds config.txt and the kernel.
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
# Networking: WiFi via wpa_supplicant + systemd-networkd, NTP, BLE stack for later features
BR2_PACKAGE_SYSTEMD_NETWORKD=y
BR2_PACKAGE_SYSTEMD_RESOLVED=y
BR2_PACKAGE_SYSTEMD_TIMESYNCD=y
BR2_PACKAGE_WPA_SUPPLICANT=y
# Provisioning writes ctrl_interface= into the wpa_supplicant config. Without the control interface
# the parser rejects that line and wpa_supplicant exits ("Failed to read or parse configuration").
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_BT=y
BR2_PACKAGE_BLUEZ5_UTILS=y
# bluetoothctl is a separate option (not part of the base bluez-utils install)
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_CA_CERTIFICATES=y
# Agent and its native libraries
BR2_PACKAGE_HOST_RUSTC=y
BR2_PACKAGE_HOST_RUST_BIN=y
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_OPUS=y
BR2_PACKAGE_LOOPI_AGENT=y
# Camera: libcamera with the Raspberry Pi (VC4) pipeline + rpicam-apps (Buildroot name libcamera-apps)
BR2_PACKAGE_LIBCAMERA=y
BR2_PACKAGE_LIBCAMERA_PIPELINE_RPI_VC4=y
BR2_PACKAGE_LIBCAMERA_APPS=y
# OTA (P4a, spec D26): RAUC on the device (CLI only: no D-Bus service, BR2_PACKAGE_RAUC_DBUS unset) and on the build host
BR2_PACKAGE_RAUC=y
BR2_PACKAGE_HOST_RAUC=y

# Copy to deploy/.env (git-ignored) and fill in.
# Generate with: openssl rand -hex 24
# Hex only: the password is embedded unencoded in a database URL, so / @ : break it.
LOOPI_DB_PASSWORD=change-me
LOOPI_DATA_DIR=/srv/loopi
# uid/gid the api container runs as; must own LOOPI_DATA_DIR. Use `id -u` / `id -g`.
LOOPI_UID=1000
LOOPI_GID=1000
LOOPI_TZ=Asia/Seoul
LOOPI_WEB_USER=admin
# Generate with: docker run --rm caddy:2.10.2 caddy hash-password --plaintext 'your-password'
# Keep the single quotes: bcrypt hashes contain '$'.
LOOPI_WEB_PASSWORD_HASH='paste-the-bcrypt-hash-here'
# Optional: lets deploy/providers.yaml route text tasks (chapters, recap, chat) to Anthropic. Only text is ever
# sent. Leave empty to stay 100 % local.
ANTHROPIC_API_KEY=

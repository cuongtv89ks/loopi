{
	auto_https off
	admin off

	# client_auth makes Caddy turn on strict_sni_host, which answers 421 whenever the TLS SNI differs from the
	# Host header. Clients send no SNI for IP-literal URLs (RFC 6066), and devices and browsers are pointed at
	# https://<LAN IP>:8443, so every such request would be refused. Turning it off is safe here: there is one
	# catch-all site (:8443) with a single TLS connection policy (verify_if_given) used for every SNI, device
	# identity comes only from the verified client certificate ({http.request.tls.client.fingerprint}), and the
	# web routes strip X-Loopi-Client-Fingerprint, so no per-host client-auth policy exists that a mismatched
	# SNI/Host pair could bypass. If a second site with a different client_auth policy is ever added, turn
	# strict SNI back on (remove this block) so a request cannot pick a looser policy through its Host header.
	servers {
		strict_sni_host insecure_off
	}
}

:8443 {
	tls /pki/server.crt /pki/server.key {
		client_auth {
			mode verify_if_given
			trust_pool file {
				pem_file /pki/ca.crt
			}
		}
	}

	# Device API: identity comes only from the verified client certificate.
	# Small bodies for JSON endpoints; only uploads get the large limit.
	@small path /v1/pair /v1/heartbeat
	handle @small {
		request_body {
			max_size 64KB
		}
		reverse_proxy api:8000 {
			header_up X-Loopi-Client-Fingerprint {http.request.tls.client.fingerprint}
		}
	}

	@device path /v1/*
	handle @device {
		request_body {
			max_size 80MB
		}
		reverse_proxy api:8000 {
			header_up X-Loopi-Client-Fingerprint {http.request.tls.client.fingerprint}
		}
	}

	# MCP (spec §10.5): read only; the brain checks the bearer token itself. No basic auth, no client certificate
	# (the site's verify_if_given policy lets a client without one through); small JSON requests only.
	# Caddy matches the cleaned path but forwards the raw one, so without the rewrite /commitments/../mcp would skip
	# basic auth and reach a web handler, and /mcp/ would draw the api's redirect to http://. The rewrite makes the
	# api see exactly /mcp (the query string is kept), so everything that skips basic auth reaches only the bearer gate.
	handle /mcp* {
		rewrite * /mcp
		request_body {
			max_size 64KB
		}
		reverse_proxy api:8000 {
			header_up -X-Loopi-Client-Fingerprint
		}
	}

	# Web UI and media: basic auth; never trust a client-supplied fingerprint header.
	handle {
		header X-Frame-Options DENY
		basic_auth {
			{$LOOPI_WEB_USER} {$LOOPI_WEB_PASSWORD_HASH}
		}
		reverse_proxy api:8000 {
			header_up -X-Loopi-Client-Fingerprint
		}
	}
}
